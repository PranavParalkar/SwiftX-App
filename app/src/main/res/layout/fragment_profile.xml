<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/swift_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="48dp">

        <TextView
            style="@style/SwiftText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Profile" />

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/swift_bg_secondary">

            <TextView
                android:id="@+id/tvProfileInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-bold"
                android:text="U"
                android:textColor="@color/swift_primary"
                android:textSize="40sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvProfileName"
            style="@style/SwiftText.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="User Name" />

        <TextView
            android:id="@+id/tvProfileEmail"
            style="@style/SwiftText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="user@example.com" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvVerifyKyc"
            style="@style/SwiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/swift_bg_card_elevated"
            app:strokeColor="@color/swift_warning"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="@color/swift_warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Verify your identity"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Unlock full limits and features"
                        android:textColor="@color/swift_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/swift_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnSecuritySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@android:drawable/ic_secure"
                android:drawablePadding="16dp"
                android:padding="20dp"
                android:text="Security Settings"
                android:textColor="@color/swift_text_primary"
                android:textSize="16sp"
                app:drawableTint="@color/swift_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/swift_divider" />

            <TextView
                android:id="@+id/btnHelpSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@android:drawable/ic_menu_help"
                android:drawablePadding="16dp"
                android:padding="20dp"
                android:text="Help Source"
                android:textColor="@color/swift_text_primary"
                android:textSize="16sp"
                app:drawableTint="@color/swift_primary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            style="@style/SwiftButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:text="Logout completely"
            android:textColor="@color/swift_error" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

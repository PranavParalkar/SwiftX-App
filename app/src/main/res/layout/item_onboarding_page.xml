<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp"
    android:background="@color/swift_bg_primary">

    <!-- Icon placeholder -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/onboardingIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:tint="@color/swift_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/onboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textColor="@color/swift_text_primary"
        android:textSize="@dimen/text_display"
        android:fontFamily="sans-serif-bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/onboardingDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/swift_text_secondary"
        android:textSize="@dimen/text_lg"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />
</LinearLayout>

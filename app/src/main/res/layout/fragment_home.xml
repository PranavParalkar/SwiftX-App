<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/swift_bg_primary"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_back_comma"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/default_user"
                    android:textColor="@color/white"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="@string/default_avatar"
                android:textColor="@color/swift_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:contentDescription="@string/cd_avatar" />
        </LinearLayout>

        <!-- Borderless Identity Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            style="@style/SwiftCard">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvRmIdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/swiftx_id_label"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:id="@+id/llRmIdContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvRmIdLabel"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRmId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/swiftx_id_placeholder"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <ImageButton
                        android:id="@+id/btnCopyRmId"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/swift_primary"
                        android:contentDescription="@string/cd_copy_id" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/llRmIdContainer"
                    android:layout_marginTop="12dp"
                    android:text="@string/swiftx_id_description"
                    android:textColor="@color/swift_text_hint"
                    android:textSize="11sp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Unified Balance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:backgroundTint="@color/swift_primary_variant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unified_balance_snapshot"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/text_sm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- USD -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/currency_usd"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvUsdBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero_balance_usd"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="12dp"
                        android:background="#33FFFFFF" />

                    <!-- INR -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/currency_inr"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvInrBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero_balance_inr"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="12dp"
                        android:background="#33FFFFFF" />

                    <!-- VAULT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/currency_vault"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvVaultBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero_balance_usd"
                            android:textColor="@color/swift_success"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/tvLiveRates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/tvYieldBadge"
                        android:layout_marginEnd="8dp"
                        app:drawableStartCompat="@android:drawable/ic_lock_lock"
                        android:drawablePadding="6dp"
                        app:drawableTint="#CCFFFFFF"
                        android:text="@string/live_conversion_active"
                        android:textColor="#CCFFFFFF"
                        android:textSize="@dimen/text_xs"
                        android:gravity="center_vertical" />

                    <TextView
                        android:id="@+id/tvYieldBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_success"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/yield_active"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_xs"
                        android:fontFamily="sans-serif-bold" />
                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Admin Dashboard Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvAdminPanel"
            style="@style/SwiftCard.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@android:drawable/ic_menu_manage"
                android:drawablePadding="16dp"
                app:drawableTint="@color/swift_secondary"
                android:text="@string/admin_dashboard_title"
                style="@style/SwiftText.Title"
                android:textSize="18sp"
                app:drawableEndCompat="@android:drawable/ic_media_play" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/quick_actions"
            android:textColor="@color/swift_text_primary"
            android:textSize="@dimen/text_xl"
            android:fontFamily="sans-serif-bold"
            android:layout_marginBottom="16dp" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:columnCount="4">

            <!-- Send -->
            <LinearLayout
                android:id="@+id/btnSendMoney"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/swift_primary"
                    android:contentDescription="@string/send_money" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/send_money"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Receive -->
            <LinearLayout
                android:id="@+id/btnReceive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:src="@drawable/ic_receive"
                    app:tint="@color/swift_primary"
                    android:contentDescription="@string/receive_money" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/receive_money"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Add -->
            <LinearLayout
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/swift_primary"
                    android:contentDescription="@string/add_funds" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/add_funds"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Exchange -->
            <LinearLayout
                android:id="@+id/btnExchange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:src="@drawable/ic_exchange"
                    app:tint="@color/swift_primary"
                    android:contentDescription="@string/exchange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/exchange"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </androidx.gridlayout.widget.GridLayout>

        <!-- AI Insight Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvInsight"
            style="@style/SwiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvAiHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:drawableStartCompat="@android:drawable/ic_menu_send"
                        android:drawablePadding="8dp"
                        app:drawableTint="@color/swift_primary"
                        android:text="@string/ai_insights"
                        android:textColor="@color/swift_text_primary"
                        android:textSize="@dimen/text_lg"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center_vertical"
                        android:contentDescription="@string/cd_ai_icon"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/tvAiInsightLabel"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/tvAiInsightLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_success"
                        android:backgroundTint="#1A00C9A7"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/powered_by_ai"
                        android:textColor="@color/swift_primary"
                        android:textSize="@dimen/text_xs"
                        android:fontFamily="sans-serif-bold" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvAiInsightDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_insight_default"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="@dimen/text_md"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Transactions Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvRecentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_transactions"
                android:textColor="@color/swift_text_primary"
                android:textSize="@dimen/text_xl"
                android:fontFamily="sans-serif-bold"
                android:layout_toStartOf="@+id/tvViewAll"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/view_all"
                android:textColor="@color/swift_primary"
                android:textSize="@dimen/text_md"
                android:fontFamily="sans-serif-medium" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

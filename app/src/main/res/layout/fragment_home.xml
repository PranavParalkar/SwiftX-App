<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/swift_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:paddingTop="48dp">


        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back,"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="@color/swift_text_primary"
                    android:textSize="@dimen/text_xxl"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/swift_bg_secondary"
                app:strokeWidth="1dp"
                app:strokeColor="@color/swift_divider">

                <TextView
                    android:id="@+id/tvAvatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="U"
                    android:textColor="@color/swift_primary"
                    android:textSize="@dimen/text_xl"
                    android:fontFamily="sans-serif-bold" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Balance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_primary"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_balance"
                            android:textColor="#CCFFFFFF"
                            android:textSize="@dimen/text_sm" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:src="@android:drawable/ic_menu_send"
                            android:tint="#99FFFFFF" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvTotalBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="$0.00"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_hero"
                        android:fontFamily="sans-serif-bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/ic_lock_lock"
                                android:tint="#CCFFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Secured by blockchain"
                                android:textColor="#CCFFFFFF"
                                android:textSize="@dimen/text_xs" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_status_success"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="✨ Zero-Fee Active"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_xs"
                            android:fontFamily="sans-serif-bold" />
                    </RelativeLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_actions"
            android:textColor="@color/swift_text_primary"
            android:textSize="@dimen/text_xl"
            android:fontFamily="sans-serif-bold"
            android:layout_marginBottom="16dp" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:columnCount="4">

            <!-- Send -->
            <LinearLayout
                android:id="@+id/btnSendMoney"

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_send"
                        app:tint="@color/swift_primary" />
                </FrameLayout>

                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/send_money"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Receive -->
            <LinearLayout
                android:id="@+id/btnReceive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_receive"
                        app:tint="@color/swift_primary" />
                </FrameLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/receive_money"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Add -->
            <LinearLayout
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/swift_primary" />
                </FrameLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/add_funds"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Exchange -->
            <LinearLayout
                android:id="@+id/btnExchange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_card">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_exchange"
                        app:tint="@color/swift_primary" />
                </FrameLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/exchange"
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </androidx.gridlayout.widget.GridLayout>

        <!-- AI Insight Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvInsight"
            style="@style/SwiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_menu_send"
                            android:tint="@color/swift_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/ai_insights"
                            android:textColor="@color/swift_text_primary"
                            android:textSize="@dimen/text_lg"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAiInsightLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_success"
                        android:backgroundTint="#1A00C9A7"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Powered by AI"
                        android:textColor="@color/swift_primary"
                        android:textSize="@dimen/text_xs"
                        android:fontFamily="sans-serif-bold" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvAiInsightDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Based on your spending patterns, you could save $120/month by optimizing your transfer schedule."
                    android:textColor="@color/swift_text_secondary"
                    android:textSize="@dimen/text_md"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Transactions -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_transactions"
                android:textColor="@color/swift_text_primary"
                android:textSize="@dimen/text_xl"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/tvViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/view_all"
                android:textColor="@color/swift_primary"
                android:textSize="@dimen/text_md"
                android:fontFamily="sans-serif-medium" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />


    </LinearLayout>
</androidx.core.widget.NestedScrollView>

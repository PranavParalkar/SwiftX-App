<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/swift_bg_primary"
    android:orientation="vertical"
    android:padding="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_surface"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            style="@style/SwiftText.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="Admin Center"
            android:textSize="20sp" />
    </RelativeLayout>

    <TextView
        style="@style/SwiftText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="KYC Review Queue" />

    <TextView
        style="@style/SwiftText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Review and approve user identification requests" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKycRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />

</LinearLayout>

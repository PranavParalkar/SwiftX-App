<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- SwiftX Dark Theme -->
    <style name="Theme.SwiftApp" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/swift_primary</item>
        <item name="colorPrimaryVariant">@color/swift_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/swift_secondary</item>
        <item name="colorSecondaryVariant">@color/swift_secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/swift_bg_primary</item>
        <item name="colorSurface">@color/swift_bg_card</item>
        <item name="colorOnSurface">@color/swift_text_primary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/swift_bg_primary</item>
        <item name="android:navigationBarColor">@color/swift_bg_secondary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <!-- Text -->
        <item name="android:textColorPrimary">@color/swift_text_primary</item>
        <item name="android:textColorSecondary">@color/swift_text_secondary</item>
        <item name="android:textColorHint">@color/swift_text_hint</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.SwiftApp.Splash" parent="Theme.SwiftApp">
        <item name="android:windowBackground">@color/swift_bg_primary</item>
    </style>

    <!-- Transparent Status Bar -->
    <style name="Theme.SwiftApp.TransparentStatus" parent="Theme.SwiftApp">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Button Styles -->
    <style name="SwiftButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="backgroundTint">@color/swift_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingLeft">@dimen/spacing_lg</item>
        <item name="android:paddingRight">@dimen/spacing_lg</item>
        <item name="rippleColor">@color/swift_ripple</item>
    </style>

    <style name="SwiftButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/swift_primary</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="strokeColor">@color/swift_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="rippleColor">@color/swift_ripple</item>
    </style>

    <style name="SwiftButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/swift_primary</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/swift_ripple</item>
    </style>

    <!-- Input Styles -->
    <style name="SwiftInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/swift_bg_input</item>
        <item name="boxStrokeColor">@color/swift_divider</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/swift_text_hint</item>
        <item name="android:textColorHint">@color/swift_text_hint</item>
    </style>

    <!-- Card Styles -->
    <style name="SwiftCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/swift_bg_card</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="SwiftCard.Elevated" parent="SwiftCard">
        <item name="cardBackgroundColor">@color/swift_bg_card_elevated</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <!-- Text Styles -->
    <style name="SwiftText">
        <item name="android:textColor">@color/swift_text_primary</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SwiftText.Hero">

        <item name="android:textColor">@color/swift_text_primary</item>
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <style name="SwiftText.Display">
        <item name="android:textColor">@color/swift_text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <style name="SwiftText.Title">
        <item name="android:textColor">@color/swift_text_primary</item>
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SwiftText.Body">
        <item name="android:textColor">@color/swift_text_secondary</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SwiftText.Caption">
        <item name="android:textColor">@color/swift_text_hint</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
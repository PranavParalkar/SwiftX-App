<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Storage permissions for KYC document upload -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- Camera permission for KYC document capture -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Optional: Vibrate for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwiftApp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SwiftApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.OnboardingActivity" />
        <activity 
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="swiftx" android:host="login-callback" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.swift_app.activities.RegisterActivity" />
        <activity android:name="com.example.swift_app.activities.MainActivity" />
        <activity android:name="com.example.swift_app.activities.SendMoneyActivity" />
        <activity android:name="com.example.swift_app.activities.ReceiveMoneyActivity" />
        <activity android:name="com.example.swift_app.activities.TransactionDetailActivity" />
        <activity android:name="com.example.swift_app.activities.KycActivity" />
        <activity android:name="com.example.swift_app.activities.ContactsActivity" />
        <activity android:name="com.example.swift_app.activities.AddFundsActivity" />
        <activity android:name="com.example.swift_app.activities.ExchangeActivity" />
        <activity android:name="com.example.swift_app.activities.AdminDashboardActivity" />

    </application>

</manifest>